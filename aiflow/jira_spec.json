{
 "workflow": {
  "name": "AI Flow Workflow v2",
  "description": "AI Flow delivery workflow (Backlog, To Do, In Progress, In Review, Review passed, In QA, Human review, Ready to merge, Blocked, Done, Declined).",
  "statuses": [
   {
    "name": "Backlog",
    "category": "TODO"
   },
   {
    "name": "To Do",
    "category": "TODO"
   },
   {
    "name": "In Progress",
    "category": "IN_PROGRESS"
   },
   {
    "name": "In Review",
    "category": "IN_PROGRESS"
   },
   {
    "name": "In QA",
    "category": "IN_PROGRESS"
   },
   {
    "name": "Done",
    "category": "DONE"
   },
   {
    "name": "Blocked",
    "category": "IN_PROGRESS"
   },
   {
    "name": "Declined",
    "category": "DONE"
   },
   {
    "name": "Human review",
    "category": "IN_PROGRESS"
   },
   {
    "name": "Ready to merge",
    "category": "IN_PROGRESS"
   },
   {
    "name": "Review passed",
    "category": "IN_PROGRESS"
   }
  ],
  "transitions": [
   {
    "name": "Ready",
    "from": [
     "Backlog"
    ],
    "to": "To Do"
   },
   {
    "name": "Not ready",
    "from": [
     "To Do"
    ],
    "to": "Backlog"
   },
   {
    "name": "Start",
    "from": [
     "To Do"
    ],
    "to": "In Progress",
    "assign_current_user": true
   },
   {
    "name": "Stop",
    "from": [
     "In Progress"
    ],
    "to": "To Do"
   },
   {
    "name": "Send to review",
    "from": [
     "In Progress"
    ],
    "to": "In Review"
   },
   {
    "name": "Resume after approval",
    "from": [
     "In Progress"
    ],
    "to": "Ready to merge"
   },
   {
    "name": "Review failed",
    "from": [
     "In Review"
    ],
    "to": "To Do"
   },
   {
    "name": "Send to QA",
    "from": [
     "In Review"
    ],
    "to": "In QA"
   },
   {
    "name": "Review passed",
    "from": [
     "In Review"
    ],
    "to": "Review passed"
   },
   {
    "name": "QA failed",
    "from": [
     "In QA"
    ],
    "to": "To Do"
   },
   {
    "name": "Done",
    "from": [
     "In QA"
    ],
    "to": "Done",
    "resolution": "Done"
   },
   {
    "name": "Request human review",
    "from": [
     "In QA"
    ],
    "to": "Human review"
   },
   {
    "name": "Reopen",
    "from": [
     "Done"
    ],
    "to": "To Do",
    "resolution": ""
   },
   {
    "name": "Unblock to To Do",
    "from": [
     "Blocked"
    ],
    "to": "To Do"
   },
   {
    "name": "Unblock to In Progress",
    "from": [
     "Blocked"
    ],
    "to": "In Progress"
   },
   {
    "name": "Unblock to In Review",
    "from": [
     "Blocked"
    ],
    "to": "In Review"
   },
   {
    "name": "Unblock to In QA",
    "from": [
     "Blocked"
    ],
    "to": "In QA"
   },
   {
    "name": "Unblock to Human review",
    "from": [
     "Blocked"
    ],
    "to": "Human review"
   },
   {
    "name": "Unblock to Ready to merge",
    "from": [
     "Blocked"
    ],
    "to": "Ready to merge"
   },
   {
    "name": "Restore",
    "from": [
     "Declined"
    ],
    "to": "Backlog",
    "resolution": ""
   },
   {
    "name": "Approve for merge",
    "from": [
     "Human review"
    ],
    "to": "Ready to merge"
   },
   {
    "name": "Request changes",
    "from": [
     "Human review"
    ],
    "to": "To Do"
   },
   {
    "name": "Merged by a human",
    "from": [
     "Human review"
    ],
    "to": "Done"
   },
   {
    "name": "Merge",
    "from": [
     "Ready to merge"
    ],
    "to": "Done"
   },
   {
    "name": "Rework after approval",
    "from": [
     "Ready to merge"
    ],
    "to": "To Do"
   },
   {
    "name": "Open pull request",
    "from": [
     "Review passed"
    ],
    "to": "In QA"
   },
   {
    "name": "Rework before pull request",
    "from": [
     "Review passed"
    ],
    "to": "To Do"
   },
   {
    "name": "Decline",
    "from": [
     "Backlog",
     "To Do",
     "In Progress",
     "In Review",
     "In QA",
     "Blocked",
     "Human review",
     "Ready to merge",
     "Review passed"
    ],
    "to": "Declined",
    "resolution": "Won't Do"
   },
   {
    "name": "Block",
    "from": [
     "To Do",
     "In Progress",
     "In Review",
     "In QA",
     "Human review",
     "Ready to merge",
     "Review passed"
    ],
    "to": "Blocked"
   }
  ]
 },
 "scheme": {
  "name": "AI Flow Workflow Scheme v2"
 },
 "issue_types": [
  {
   "name": "Release",
   "description": "A release of the project: AI Flow runs the full check, prepares the version and merges to the production branch."
  }
 ],
 "fields": [
  {
   "name": "Agent (AI)",
   "type": "select",
   "description": "AI agent that works on the issue",
   "options": [
    "Codex",
    "Claude",
    "Grok",
    "OpenCode"
   ]
  },
  {
   "name": "Workspace",
   "type": "text",
   "description": "Machine working on the ticket (set by AI Flow)"
  },
  {
   "name": "Blocked reason",
   "type": "text",
   "description": "Why the ticket is Blocked, as `Kind: reason` (set by AI Flow)"
  },
  {
   "name": "Require human",
   "type": "select",
   "description": "Yes: the ticket stops in Human review before the merge",
   "options": [
    "Yes",
    "No"
   ]
  },
  {
   "name": "AI Model",
   "type": "select",
   "description": "Model per ticket, as <AI>:<Model>",
   "options": [
    "Codex:gpt-6-luna",
    "Codex:gpt-5.6-terra",
    "Codex:gpt-5.6-luna",
    "Claude:fable",
    "Claude:opus",
    "Claude:sonnet",
    "Claude:haiku",
    "Grok:grok-4.7",
    "Grok:grok-4.7-build-fast",
    "Grok:grok-4.6",
    "Grok:grok-4.5",
    "OpenCode:opencode/deepseek-v4.1-flash-free",
    "OpenCode:opencode/big-pickle",
    "OpenCode:opencode/glm-5.3-flash-free",
    "OpenCode:opencode/mimo-v2.6-flash-free",
    "OpenCode:opencode/nemotron-3-ultra-free",
    "OpenCode:opencode/longcat-2.5-preview-free",
    "OpenCode:opencode-go/deepseek-v4-pro",
    "OpenCode:opencode-go/kimi-k3",
    "OpenCode:opencode-go/qwen3.8-max",
    "OpenCode:openai/gpt-5.4-mini",
    "OpenCode:openai/gpt-5.6-luna",
    "OpenCode:openai/gpt-6-luna"
   ]
  },
  {
   "name": "Type",
   "type": "select",
   "description": "Kind of change; decides the commit type and the base branch",
   "options": [
    "Feature",
    "Bug",
    "Hotfix",
    "Chore",
    "Docs",
    "Refactor"
   ]
  },
  {
   "name": "Version",
   "type": "text",
   "description": "Version x.y.z of a Release ticket"
  }
 ]
}
