#!/usr/bin/env bash
# Install AI Flow as systemd user services (WSL).
#   bin/install-wsl-service --workers       one aiflow-work@<n> per worker of this machine (JOOservices/config/aiflow.toml)
#   bin/install-wsl-service 1 2              legacy supervisor slots 1 and 2
set -Eeuo pipefail
DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
UNITS="$HOME/.config/systemd/user"
mkdir -p "$UNITS"
cp "$DIR"/deploy/systemd/aiflow-* "$UNITS/"
systemctl --user daemon-reload
if [ "${1:-}" = "--workers" ]; then
  "$DIR/bin/aiflow-work" check
  for worker in $("$DIR/bin/aiflow-work" list); do systemctl --user enable --now "aiflow-work@$worker.service"; done
else
  for slot in ${*:-1 2}; do systemctl --user enable --now "aiflow-supervisor@$slot.service"; done
fi
systemctl --user enable --now aiflow-health.timer
loginctl show-user "$USER" -p Linger
systemctl --user list-units 'aiflow-*' --no-legend
