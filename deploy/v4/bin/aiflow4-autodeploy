#!/bin/bash
# Deploy the newest published vX.Y.Z from master through a measured one-node canary.
# Run by aiflow4-autodeploy.timer on the control-plane machine.
set -uo pipefail
ROOT=${AIFLOW4_ROOT:-/srv/aiflow}
[ -r /etc/aiflow/deploy.env ] && { set -a; . /etc/aiflow/deploy.env; set +a; }
# lab hosts on the develop channel follow origin/develop instead of signed releases (docs/v4/develop-channel.md)
[ "${AIFLOW4_CHANNEL:-release}" = develop ] && exec /usr/local/sbin/aiflow4-autodeploy-develop
R=$ROOT/control/repos/ai-flow
RELEASES=$ROOT/control/releases
CURRENT_FILE=$RELEASES/CURRENT
CANARY_FILE=$RELEASES/CANARY.json
REJECTED_FILE=$RELEASES/CANARY_REJECTED
FAILURES_FILE=$RELEASES/PROMOTION_FAILURES.json
CUR=$(cat "$CURRENT_FILE" 2>/dev/null || true)
# shellcheck disable=SC2034 # assigned from the settings but not read in this script; the control plane judges the age
CANARY_MIN_AGE_S=${AIFLOW4_CANARY_MIN_AGE_S:-300}
CANARY_MIN_RUNS=${AIFLOW4_CANARY_MIN_RUNS:-3}
CANARY_MAX_AGE_S=${AIFLOW4_CANARY_MAX_AGE_S:-900}
CANARY_FAILURE_RATIO=${AIFLOW4_CANARY_FAILURE_RATIO:-2}
CANARY_MIN_INFRA_FAILURES=${AIFLOW4_CANARY_MIN_INFRA_FAILURES:-3}
CANARY_INSTALL_TIMEOUT_S=${AIFLOW4_CANARY_INSTALL_TIMEOUT_S:-$(( CANARY_MAX_AGE_S < 1800 ? CANARY_MAX_AGE_S : 1800 ))}
AIFLOW4_CANARY_NODE=${AIFLOW4_CANARY_NODE:-}
load_canary_settings() {
  local state age runs max
  state=$(control_state 2>/dev/null) || return 0
  IFS=$'\t' read -r age runs max < <(python3 -c 'import json,sys
d=json.load(sys.stdin).get("control_canary",{}).get("settings") or {}
print(d.get("minimum_age_s") or "", d.get("minimum_runs") if d.get("minimum_runs") is not None else "", d.get("maximum_age_s") or "", sep="\t")' <<<"$state") || return 0
  # shellcheck disable=SC2034 # see the default above
  [ -n "$age" ] && CANARY_MIN_AGE_S=$age
  [ -n "$runs" ] && CANARY_MIN_RUNS=$runs
  [ -n "$max" ] && CANARY_MAX_AGE_S=$max
  if [ -z "${AIFLOW4_CANARY_INSTALL_TIMEOUT_S:-}" ]; then
    CANARY_INSTALL_TIMEOUT_S=$(( CANARY_MAX_AGE_S < 1800 ? CANARY_MAX_AGE_S : 1800 ))
  fi
}
note_newer_while_canary() {
  local active=$1 newest=$2 merged_at
  [ -n "$newest" ] && [ "$newest" != "$active" ] || return 0
  merged_at=$(git -C "$R" log -1 --format=%cI "$newest" 2>/dev/null || now_utc)
  canary_cli note-pending --build "$newest" --merged-at "$merged_at" \
    || echo "could not note pending release $newest" >&2
}
note_target_pending() {
  local build=$1 merged_at
  merged_at=$(git -C "$R" log -1 --format=%cI "$build" 2>/dev/null) || merged_at=
  [ -n "$merged_at" ] || { echo "could not read merge timestamp for $build" >&2; return 1; }
  canary_cli note-pending --build "$build" --merged-at "$merged_at"
}
mark_target_live() {
  local target=$1 state build
  local -a covered_args=()
  state=$(control_state 2>/dev/null) || state=
  while IFS= read -r build; do
    [ -n "$build" ] && [ "$build" != "$target" ] || continue
    if git -C "$R" merge-base --is-ancestor "$build" "$target" 2>/dev/null; then
      covered_args+=(--covered-build "$build")
    fi
  done < <(python3 -c 'import json,sys; d=json.load(sys.stdin).get("control_canary",{}) or {}; print("\n".join(str(x.get("build") or "") for x in d.get("pending",[])))' <<<"$state" 2>/dev/null)
  canary_cli mark-live --build "$target" "${covered_args[@]}"
}
# the acceptance test points these at a mock control endpoint (docs/v4/clean-install-acceptance.md)
CONTROL_URL=${AIFLOW4_CONTROL_URL:-http://127.0.0.1}
CONTROL_ENV=${AIFLOW4_CONTROL_ENV:-${AIFLOW4_SECRETS_DIR:-/etc/aiflow/secrets/control}/aiflow4.env}

mkdir -p "$RELEASES"
exec 8>"$RELEASES/autodeploy.lock"
flock -n 8 || { echo "another auto-deploy pass is running"; exit 0; }

alert() {
  local severity=info
  case "$1" in
    '[CRITICAL]'*) severity=critical ;;
    '[WARNING]'*) severity=warning ;;
  esac
  docker exec aiflow4-control-api-a aiflow4 notify --severity "$severity" --title "$1" --detail "$2" >/dev/null 2>&1 || \
    echo "stored-channel notification could not be sent" >&2
}

# /v1/state needs a console session when sign-in is on. These scripts sign in to the token routes of the control API
# (/v1/deploy/*) with the owner token from the root-only secret file; it goes to curl on stdin, not on a command line.
owner_token() {
  [ -n "${AIFLOW4_OWNER_TOKEN:-}" ] && { printf '%s' "$AIFLOW4_OWNER_TOKEN"; return; }
  sed -n 's/^AIFLOW4_OWNER_TOKEN=//p' "$CONTROL_ENV" 2>/dev/null | tail -1
}
control_get() { printf 'Authorization: Bearer %s\n' "$(owner_token)" | curl -fsS -H @- "${CONTROL_URL}$1"; }
control_state() { control_get /v1/deploy/state; }
# aiflow4-deploy exits 9 when the pre-upgrade check refused TARGET; nothing changed on the control plane. Remember
# the release so the timer does not retry it until a newer one is published.
upgrade_blocked() {
  printf '%s\n' "$TARGET" > "$REJECTED_FILE.tmp" && mv -f "$REJECTED_FILE.tmp" "$REJECTED_FILE"
  echo "pre-upgrade check blocked $TARGET; the control plane keeps ${CUR:-its release}"
  alert "[CRITICAL] AI Flow: upgrade to $TARGET blocked" \
    "The pre-upgrade check refused $TARGET (migration changed or deleted, or a node would leave the version skew policy). The control plane keeps ${CUR:-its release}; the reasons are in the upgrade_blocked incident."
  exit 1
}
canary_cli() { docker exec aiflow4-control-api-a aiflow4 canary "$@"; }
now_utc() { python3 -c 'from datetime import datetime,timezone; print(datetime.now(timezone.utc).isoformat())'; }
# Promotion helpers live in the ai-flow checkout (docs/v4/upgrade-layout.md).
promotion_py() {
  local src=$R
  [ -d "$R/aiflow/v4/install" ] || src=
  PYTHONPATH="${src:+$src}${src:+:}${PYTHONPATH:-}" python3 "$@"
}
ensure_host_layout() {
  # AIFLOW4_SECRETS_DIR overrides the production default so lab/tests can point at a writable tree.
  local secrets=${AIFLOW4_SECRETS_DIR:-/etc/aiflow/secrets}
  promotion_py - "$secrets" <<'P' || { echo "host layout could not be prepared under $secrets" >&2; return 1; }
from pathlib import Path
import sys
from aiflow.v4.install.secrets import ensure_runtime_layout
ensure_runtime_layout(Path(sys.argv[1]))
P
}
merged_not_live() {
  local previous=$1 target=$2
  git -C "$R" rev-list --count "${previous}..${target}" 2>/dev/null || echo unknown
}
extract_deploy_error() {
  local log=$1
  # Prefer a missing-file line; otherwise the last non-empty deploy line (sed only: no tail).
  if grep -Eiq 'not found|no such file|env file' "$log" 2>/dev/null; then
    grep -Ei 'not found|no such file|env file' "$log" | sed -n '$p'
    return
  fi
  sed '/^$/d' "$log" | sed -n '$p'
}
# Retry Jira work even when the rollback incident already exists and CANARY.json has been removed.
canary_cli retry-tickets || echo "could not retry pending canary flow-bug tickets" >&2
load_canary_settings
write_canary() {
  python3 - "$CANARY_FILE" "$1" "$2" "$3" "$4" "$5" <<'P'
import json, os, sys
path, target, node, previous, started, requested = sys.argv[1:]
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump({"target": target, "node": node, "previous": previous, "started_at": started,
               "requested_at": requested}, f)
    f.write("\n")
os.replace(tmp, path)
P
}
# Reject the candidate: CANARY_REJECTED stops a retry, removing CANARY.json returns the node to CURRENT on its
# next heartbeat, the registry gets an incident and a flow-bug, and the owner gets a CRITICAL alert.
reject_canary() {
  local why=$1 measurements=$2 commit
  commit=$(git -C "$R" rev-list -n 1 "refs/tags/$TARGET" 2>/dev/null || true)
  [ -n "$commit" ] || commit=unknown
  printf '%s\n' "$TARGET" > "$REJECTED_FILE.tmp" && mv -f "$REJECTED_FILE.tmp" "$REJECTED_FILE"
  rm -f "$CANARY_FILE"
  canary_cli record-rollback --node "$NODE" --target "$TARGET" --previous "$PREVIOUS" \
    --commit "$commit" --measurements "$measurements" || echo "could not write canary rollback incident/ticket" >&2
  echo "canary $TARGET $why; $NODE returned to $PREVIOUS"
  alert "[CRITICAL] AI Flow: canary $TARGET rolled back" \
    "Canary node $NODE returned to $PREVIOUS: $why. Suspected commit: $commit. The registry has a canary incident; a flow-bug ticket was requested."
}

if [ -f "$CANARY_FILE" ]; then
  IFS=$'\t' read -r TARGET NODE PREVIOUS STARTED_AT REQUESTED_AT < <(python3 - "$CANARY_FILE" <<'P'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    print(d["target"], d["node"], d["previous"], d.get("started_at") or "-", d.get("requested_at") or "-", sep="\t")
except (OSError, ValueError, KeyError):
    raise SystemExit("invalid canary state")
P
  ) || { echo "cannot read $CANARY_FILE" >&2; exit 1; }
  [ -n "${TARGET:-}" ] && [ -n "${NODE:-}" ] && [ -n "${PREVIOUS:-}" ] || {
    echo "canary state is incomplete" >&2; exit 1;
  }
  [ "$STARTED_AT" != - ] || STARTED_AT=
  [ "$REQUESTED_AT" != - ] || REQUESTED_AT=
  note_target_pending "$TARGET" || echo "could not note canary build $TARGET as pending" >&2
  # A newer release must not restart this canary; note it and finish the build under test first.
  git -C "$R" fetch -q origin master --tags || true
  NEWEST=$(git -C "$R" tag --merged origin/master --list 'v[0-9]*' --sort=-version:refname | head -n 1)
  note_newer_while_canary "$TARGET" "$NEWEST"
  if [ -z "${STARTED_AT:-}" ]; then
    NODE_RELEASE=$(control_state | python3 -c 'import json,sys; d=json.load(sys.stdin); n=next((x for x in d["nodes"] if x["name"]==sys.argv[1]),None); print(n["release"] if n else "")' "$NODE" 2>/dev/null || true)
    if [ "$NODE_RELEASE" != "$TARGET" ]; then
      if [ -z "$REQUESTED_AT" ]; then
        # State written before requested_at existed: start the install clock now.
        write_canary "$TARGET" "$NODE" "$PREVIOUS" "" "$(now_utc)"
        echo "waiting for canary node $NODE to install $TARGET (currently ${NODE_RELEASE:-unknown})"
        exit 0
      fi
      WAITED=$(python3 -c 'import sys; from datetime import datetime,timezone; print(max(0,int((datetime.now(timezone.utc)-datetime.fromisoformat(sys.argv[1])).total_seconds())))' "$REQUESTED_AT") || WAITED=0
      if [ "$WAITED" -ge "$CANARY_INSTALL_TIMEOUT_S" ]; then
        # The installer switched back (exit 6) or the node is offline: the candidate never ran there.
        WHY="was not installed on $NODE within ${CANARY_INSTALL_TIMEOUT_S}s (node reports ${NODE_RELEASE:-unknown})"
        MEASUREMENTS=$(python3 -c 'import json,sys; zero={"runs":0,"infra_failures":0,"failure_rate":0.0}; print(json.dumps({"action":"rollback","rollback_reason":sys.argv[1],"canary":zero,"baseline":zero}))' "$WHY")
        reject_canary "$WHY" "$MEASUREMENTS"
        exit 0
      fi
      echo "waiting for canary node $NODE to install $TARGET (currently ${NODE_RELEASE:-unknown}, ${WAITED}s of ${CANARY_INSTALL_TIMEOUT_S}s)"
      exit 0
    fi
    STARTED_AT=$(now_utc)
    write_canary "$TARGET" "$NODE" "$PREVIOUS" "$STARTED_AT" "$REQUESTED_AT"
    echo "canary node $NODE installed $TARGET; observation window started"
    exit 0
  fi

  DECISION=$(canary_cli evaluate --node "$NODE" --target "$TARGET" --previous "$PREVIOUS" \
    --started-at "$STARTED_AT" --from-settings --failure-ratio "$CANARY_FAILURE_RATIO" \
    --minimum-infra-failures "$CANARY_MIN_INFRA_FAILURES") || {
      echo "could not read canary run measurements; keeping $TARGET isolated on $NODE" >&2; exit 1;
    }
  ACTION=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["action"])' <<<"$DECISION")
  CAUSE=$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("cause") or "slow")' <<<"$DECISION")
  case "$ACTION" in
    wait)
      echo "canary $TARGET on $NODE ($CAUSE): $(python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["reason"])' <<<"$DECISION")"
      exit 0
      ;;
    rollback)
      reject_canary "failed its infrastructure rate threshold (cause: failures)" "$DECISION"
      exit 0
      ;;
    promote)
      UNDER_OBSERVED=$(python3 -c 'import json,sys; d=json.load(sys.stdin); print("yes" if d.get("cause")=="too_few_runs" or "too few" in d["reason"] or "lack of work" in d["reason"] else "no")' <<<"$DECISION")
      if [ "$UNDER_OBSERVED" = yes ]; then
        canary_cli record-promotion --node "$NODE" --target "$TARGET" --measurements "$DECISION" \
          --minimum-runs "$CANARY_MIN_RUNS" \
          || echo "could not record under-observed canary note" >&2
      fi
      rm -f "$CANARY_FILE"
      echo "canary $TARGET on $NODE is stable (cause: $CAUSE); promoting to the control plane and remaining nodes"
      ;;
    *) echo "unknown canary decision: $ACTION" >&2; exit 1 ;;
  esac
else
  git -C "$R" fetch -q origin master --tags || exit 0
  TARGET=$(git -C "$R" tag --merged origin/master --list 'v[0-9]*' --sort=-version:refname | head -n 1)
  [ -n "$TARGET" ] || { echo "no versioned release tag on master"; exit 0; }
  [ "$TARGET" != "$CUR" ] || exit 0
  ensure_host_layout || exit 1
  TRY=$(promotion_py - "$REJECTED_FILE" "$FAILURES_FILE" "$TARGET" <<'P'
import sys
from pathlib import Path
from aiflow.v4.install.promotion import load_failures, should_try_build
rejected = Path(sys.argv[1]).read_text().strip() if Path(sys.argv[1]).is_file() else ""
ok, reason = should_try_build(rejected=rejected, target=sys.argv[3],
                              failures=load_failures(Path(sys.argv[2])))
print("yes" if ok else "no")
print(reason)
P
) || TRY=$'no\ncould not read promotion failure state'
  TRY_OK=$(printf '%s\n' "$TRY" | sed -n '1p')
  TRY_REASON=$(printf '%s\n' "$TRY" | sed -n '2p')
  if [ "$TRY_OK" != yes ]; then
    echo "${TRY_REASON:-release $TARGET is blocked until its promotion cause changes}"
    exit 0
  fi
  ASSETS=$(gh release view "$TARGET" --repo jooservices/ai-flow --json assets --jq '.assets[].name' 2>/dev/null) || {
    echo "release $TARGET has not been published yet"; exit 0
  }
  for asset in "aiflow4-$TARGET.tar.gz" "aiflow4-$TARGET.tar.gz.sigstore.json" SHA256SUMS; do
    if ! grep -Fxq "$asset" <<<"$ASSETS"; then
      echo "release $TARGET is missing $asset"; exit 0
    fi
  done

  # A commit id is the pre-versioned develop install and cannot be restored by a signed node update. Keep its
  # existing control-plane health rollback path for the first tagged release; all version-to-version upgrades
  # use the canary flow below.
  if [[ ! $CUR =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
    echo "deploying first versioned release $TARGET (was ${CUR:-none})"
    aiflow4-deploy "$TARGET"; RC=$?
    [ "$RC" -ne 9 ] || upgrade_blocked
    if [ "$RC" -eq 0 ]; then
      sleep 20
      if curl -fsS "$CONTROL_URL/healthz" >/dev/null && control_state | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["nodes"]' \
         && curl -fsS -o /dev/null "$CONTROL_URL/cc"; then
        echo "deployed $TARGET"; alert "[INFO] AI Flow: deployed $TARGET" "Versioned release $TARGET passed the health checks (previous ${CUR:-none})."; exit 0
      fi
    fi
    # Before the first versioned release, CURRENT is a commit id deployed by the old develop flow. Its image
    # and build tree are still on this host, so restore them when health checks fail.
    rollback_commit() {
      local cf="$ROOT/build/$CUR/deploy/v4/control/compose.yaml" svc
      docker image inspect "aiflow4/control:$CUR" >/dev/null 2>&1 || { echo "image aiflow4/control:$CUR is gone"; return 1; }
      [ -f "$cf" ] || { echo "build tree of $CUR is gone"; return 1; }
      for svc in control-api-a control-api-b control-loops; do
        AIFLOW4_IMAGE_REPOSITORY=aiflow4/control AIFLOW4_IMAGE_TAG=$CUR \
          docker compose -f "$cf" up -d --no-deps "$svc" || return 1
      done
      printf '%s\n' "$CUR" > "$CURRENT_FILE.tmp" && mv -f "$CURRENT_FILE.tmp" "$CURRENT_FILE" || return 1
      if [ -x "$ROOT/releases/$CUR/.venv/bin/aiflow4" ]; then
        ln -sfn "$ROOT/releases/$CUR" "$ROOT/current.new" && mv -T "$ROOT/current.new" "$ROOT/current"
        systemctl restart aiflow4-node-agent
      fi
    }
    echo "deploy of $TARGET unhealthy; rolling back to ${CUR:-none}"
    ROLLED_BACK=no
    if [[ $CUR =~ ^[0-9a-f]{7,40}$ ]]; then rollback_commit && ROLLED_BACK=yes; fi
    if [ "$ROLLED_BACK" = yes ]; then
      alert "[CRITICAL] AI Flow: auto-deploy of $TARGET rolled back" "The control plane was unhealthy after deploying $TARGET; it runs $CUR again. Look at the release checks and control logs."
    else
      echo "no rollback happened; the control plane may still run $TARGET"
      alert "[CRITICAL] AI Flow: auto-deploy of $TARGET failed, NOT rolled back" "The control plane was unhealthy after deploying $TARGET and could not be rolled back to ${CUR:-none}. It may still run $TARGET: restore it by hand, then look at the release checks and control logs."
    fi
    exit 1
  fi

  STATE=$(control_state) || { echo "control registry is unavailable; not starting a canary" >&2; exit 1; }
  NODE=$(python3 -c 'import json,sys; configured,previous=sys.argv[1:]; nodes=json.load(sys.stdin).get("nodes",[]); eligible=lambda n:n.get("status")=="online" and n.get("release")==previous and n.get("accounts_assigned",0)>0; selected=next((n for n in nodes if n.get("name")==configured and eligible(n)),None) if configured else next(iter(sorted((n for n in nodes if eligible(n)),key=lambda n:n["name"])),None); print(selected["name"] if selected else "")' \
    "$AIFLOW4_CANARY_NODE" "$CUR" <<<"$STATE") || exit 1
  if [ -z "$NODE" ]; then
    echo "no online node on $CUR with assigned accounts is available for canary"
    exit 0
  fi
  echo "staging $TARGET for canary node $NODE; fleet remains on $CUR"
  aiflow4-deploy --stage-only "$TARGET" || { echo "could not stage $TARGET" >&2; exit 1; }
  note_target_pending "$TARGET" || echo "could not note canary build $TARGET as pending" >&2
  write_canary "$TARGET" "$NODE" "$CUR" "" "$(now_utc)"
  echo "canary $TARGET requested on $NODE; other nodes remain on $CUR"
  exit 0
fi

# A promoted release is deployed to the control plane, then CURRENT starts the rolling node upgrade
# (canary node, then waves; docs/v4/fleet-upgrade.md).
DEPLOY_LOG=$RELEASES/deploy-attempt.log
if ! ensure_host_layout; then
  DEPLOY_ERROR="host layout could not be prepared under ${AIFLOW4_SECRETS_DIR:-/etc/aiflow/secrets}"
  RC=1
else
  aiflow4-deploy "$TARGET" >"$DEPLOY_LOG" 2>&1; RC=$?
  cat "$DEPLOY_LOG"
fi
[ "$RC" -ne 9 ] || rm -f "$DEPLOY_LOG"
[ "$RC" -ne 9 ] || upgrade_blocked
if [ "$RC" -eq 0 ]; then
  sleep 20
  if curl -fsS "$CONTROL_URL/healthz" >/dev/null && control_state | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["nodes"]' \
     && curl -fsS -o /dev/null "$CONTROL_URL/cc"; then
    mark_target_live "$TARGET" || echo "could not record merge-to-live for $TARGET" >&2
    echo "deployed $TARGET to the control plane; remaining nodes will update from CURRENT"
    promotion_py - "$FAILURES_FILE" <<'P'
from pathlib import Path
import sys
from aiflow.v4.install.promotion import clear_failures
clear_failures(Path(sys.argv[1]))
P
    rm -f "$DEPLOY_LOG"
    alert "[INFO] AI Flow: deployed $TARGET" "Canary on $NODE passed (cause: ${CAUSE:-ok}); release $TARGET is now desired by the fleet (previous $CUR)."
    exit 0
  fi
  DEPLOY_ERROR="deploy unhealthy: healthz, registry state or Command Center check failed after promoting $TARGET"
else
  [ -n "${DEPLOY_ERROR:-}" ] || DEPLOY_ERROR=$(extract_deploy_error "$DEPLOY_LOG")
  [ -n "$DEPLOY_ERROR" ] || DEPLOY_ERROR="aiflow4-deploy exited $RC"
fi
rm -f "$DEPLOY_LOG"
NOT_LIVE=$(merged_not_live "${CUR:-$PREVIOUS}" "$TARGET")
STATE=$(promotion_py - "$FAILURES_FILE" "$TARGET" "deploy" "$DEPLOY_ERROR" "$NOT_LIVE" "${CUR:-$PREVIOUS}" <<'P'
import json, sys
from pathlib import Path
from aiflow.v4.install.promotion import alert_detail, record_failure
state = record_failure(Path(sys.argv[1]), build=sys.argv[2], step=sys.argv[3], error=sys.argv[4])
detail = alert_detail(build=sys.argv[2], step=sys.argv[3], error=sys.argv[4], not_live=sys.argv[5],
                      previous=sys.argv[6], count=state["count"], exhausted=state["exhausted"])
print(json.dumps({"exhausted": state["exhausted"], "detail": detail, "cause": state["cause"]}))
P
) || STATE='{"exhausted": false, "detail": "promotion failed", "cause": "unknown"}'
EXHAUSTED=$(promotion_py -c 'import json,sys; print("yes" if json.load(sys.stdin)["exhausted"] else "no")' <<<"$STATE")
DETAIL=$(promotion_py -c 'import json,sys; print(json.load(sys.stdin)["detail"])' <<<"$STATE")

# Keep the existing control-plane rollback for a health failure after the fleet promotion.
echo "deploy of $TARGET unhealthy; rolling back to ${CUR:-none}"
ROLLED_BACK=no
if [[ $CUR =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
  # the pre-upgrade check would refuse the older release: the newer one may have applied migrations it lacks
  AIFLOW4_SKIP_UPGRADE_CHECK=1 aiflow4-deploy "$CUR" && ROLLED_BACK=yes
fi
if [ "$EXHAUSTED" = yes ]; then
  printf '%s\n' "$TARGET" > "$REJECTED_FILE.tmp" && mv -f "$REJECTED_FILE.tmp" "$REJECTED_FILE"
fi
if [ "$ROLLED_BACK" = yes ]; then
  alert "[CRITICAL] AI Flow: promotion of $TARGET failed" "$DETAIL Rolled back to $CUR."
else
  alert "[CRITICAL] AI Flow: promotion of $TARGET failed, NOT rolled back" \
    "$DETAIL Could not roll back to ${CUR:-none}; restore it by hand."
fi
exit 1
