#!/bin/bash
# Deploy one signed v4 release from GitHub: aiflow4-deploy <vX.Y.Z>
set -euo pipefail
VERSION=${1:-}
if [[ ! $VERSION =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
  echo "usage: aiflow4-deploy vX.Y.Z" >&2; exit 2
fi
exec 9>/run/aiflow4-deploy.lock
flock -w 1800 9 || { echo "another deploy is running" >&2; exit 8; }

REPO=/srv/aiflow/control/repos/ai-flow
RELEASES=/srv/aiflow/control/releases
IMAGE=ghcr.io/jooservices/ai-flow/control-api
IDENTITY="https://github.com/jooservices/ai-flow/.github/workflows/release-v4.yml@refs/tags/$VERSION"
mkdir -p "$RELEASES"
cd "$REPO"
git fetch -q origin master --tags
git rev-parse -q --verify "refs/tags/$VERSION^{commit}" >/dev/null || {
  echo "tag $VERSION is not available in origin" >&2; exit 2;
}
if ! git merge-base --is-ancestor "refs/tags/$VERSION" origin/master; then
  echo "tag $VERSION does not point to a commit on master" >&2; exit 2
fi

WORK=$(mktemp -d "$RELEASES/.download-$VERSION.XXXXXX")
trap 'rm -rf "$WORK"' EXIT
gh release download "$VERSION" --repo jooservices/ai-flow --dir "$WORK" \
  --pattern "aiflow4-$VERSION.tar.gz" \
  --pattern "aiflow4-$VERSION.tar.gz.sigstore.json" \
  --pattern SHA256SUMS
TAR="$WORK/aiflow4-$VERSION.tar.gz"
BUNDLE="$TAR.sigstore.json"
(cd "$WORK" && sha256sum --check SHA256SUMS)
cosign verify-blob "$TAR" --bundle "$BUNDLE" \
  --certificate-identity "$IDENTITY" \
  --certificate-oidc-issuer https://token.actions.githubusercontent.com

docker pull "$IMAGE:$VERSION"
cosign verify "$IMAGE:$VERSION" \
  --certificate-identity "$IDENTITY" \
  --certificate-oidc-issuer https://token.actions.githubusercontent.com >/dev/null

B="/srv/aiflow/build/$VERSION"
rm -rf "$B" && mkdir -p "$B"
tar -xzf "$TAR" -C "$B"
mkdir -p "$RELEASES"
STAGED="$RELEASES/.$VERSION.new"
rm -rf "$STAGED" && mkdir -p "$STAGED"
install -m 0644 "$TAR" "$STAGED/$(basename "$TAR")"
install -m 0644 "$BUNDLE" "$STAGED/$(basename "$BUNDLE")"
install -m 0644 "$WORK/SHA256SUMS" "$STAGED/SHA256SUMS"
rm -rf "$RELEASES/$VERSION"
mv "$STAGED" "$RELEASES/$VERSION"

CF="$B/deploy/v4/control/compose.yaml"
healthy() { [ "$(docker inspect -f '{{.State.Health.Status}}' "$1" 2>/dev/null)" = healthy ]; }
for svc in control-api-a control-api-b; do
  AIFLOW4_IMAGE_REPOSITORY=$IMAGE AIFLOW4_IMAGE_TAG=$VERSION AIFLOW4_VERSION=$VERSION \
    docker compose -f "$CF" up -d --no-deps "$svc" 2>&1 | grep -v -e '^$' | tail -1
  for i in $(seq 1 40); do healthy "aiflow4-$svc" && break; sleep 2; done
  healthy "aiflow4-$svc" || { echo "$svc did not become healthy" >&2; exit 5; }
  sleep 4
  docker rm -f aiflow4-control-api >/dev/null 2>&1 || true
done
AIFLOW4_IMAGE_REPOSITORY=$IMAGE AIFLOW4_IMAGE_TAG=$VERSION AIFLOW4_VERSION=$VERSION \
  docker compose -f "$CF" up -d --no-deps control-loops 2>&1 | grep -v -e '^$' | tail -1

install -m 0755 "$B/deploy/v4/bin/aiflow4-node-install" "$B/deploy/v4/bin/aiflow4-deploy" \
  "$B/deploy/v4/bin/aiflow4-autodeploy" "$B/deploy/v4/bin/aiflow4-develop-install" \
  "$B/deploy/v4/bin/aiflow4-deploy-develop" "$B/deploy/v4/bin/aiflow4-autodeploy-develop" /usr/local/sbin/
install -m 0644 "$B"/deploy/v4/control/systemd/aiflow4-autodeploy.* /etc/systemd/system/
systemctl daemon-reload && systemctl enable -q --now aiflow4-autodeploy.timer
mkdir -p /root/.bridge/out/release
rm -f /root/.bridge/out/release/*.tar.gz*
cp "$TAR" "$BUNDLE" "$WORK/SHA256SUMS" /root/.bridge/out/release/
printf '%s\n' "$VERSION" > /root/.bridge/out/release/VERSION
aiflow4-node-install "$RELEASES/$VERSION/$(basename "$TAR")" "$VERSION" \
  "$RELEASES/$VERSION/$(basename "$BUNDLE")" "$(awk 'NR==1 {print $1}' "$WORK/SHA256SUMS")"
printf '%s\n' "$VERSION" > "$RELEASES/CURRENT.tmp"
mv -f "$RELEASES/CURRENT.tmp" "$RELEASES/CURRENT"
ls -1dt "$RELEASES"/v[0-9]*.[0-9]*.[0-9]*/ 2>/dev/null | tail -n +11 | xargs -r rm -rf
for i in $(seq 1 30); do curl -fsS http://127.0.0.1/healthz >/dev/null 2>&1 && break; sleep 2; done
echo "deployed $VERSION"
