# Which Jira projects the supervisor watches (comma separated).
AIFLOW_PROJECTS=JAIF
# Name of this machine in comments and leases (mac, wsl).
AIFLOW_MACHINE=wsl
AIFLOW_SLOT=1
# Shared Redis (workspaces-shared). Database index comes from `scripts/docker/shared provision-project ai-flow --redis`.
AIFLOW_REDIS_CONTAINER=workspaces-shared-redis-1
REDIS_DB=5
AIFLOW_REDIS_PREFIX=aiflow:
# Timing (seconds unless noted).
AIFLOW_POLL_SECONDS=30
AIFLOW_HEARTBEAT_SECONDS=20
AIFLOW_LEASE_SECONDS=120
AIFLOW_ORPHAN_GRACE_SECONDS=180
AIFLOW_IDLE_MINUTES=30
AIFLOW_MAX_MINUTES=180
AIFLOW_MAX_ATTEMPTS=3
AIFLOW_QUOTA_COOLDOWN_MINUTES=30
# Defaults used when the ticket has no "Repo:" / "Base:" line.
AIFLOW_DEFAULT_REPO=ai-flow
AIFLOW_DEFAULT_BASE=develop
AIFLOW_AGENT_ORDER=Claude,Codex,OpenCode
# AI per role, as Agent[:model[:effort]]. The Jira field "Agent (AI)" wins for the developer. Codex reads its own model from ~/.codex/config.toml.
AIFLOW_DEVELOPER_DEFAULT=Codex
AIFLOW_REVIEWER_DEFAULT=Claude:sonnet
AIFLOW_QA_DEFAULT=
# Pull-request gate. Repos are comma separated; * means every repo.
AIFLOW_AUTO_MERGE_REPOS=*
AIFLOW_CI_REQUIRED_REPOS=
AIFLOW_CI_WAIT_MINUTES=30
AIFLOW_FEEDBACK_SETTLE_MINUTES=5
AIFLOW_GATE_POLL_SECONDS=60
AIFLOW_MERGE_METHOD=merge
AIFLOW_MAX_CYCLES=6
# Accounts whose pull-request comments are automation, not feedback (reviews and threads of bots still count).
AIFLOW_IGNORED_AUTHORS=codecov-commenter,github-actions,sonarqubecloud,sonarcloud,dependabot,codeql,github-advanced-security
# Jira field that shows the machine working on a ticket (text field "Workspace").
AIFLOW_WORKSPACE_FIELD=customfield_10214
# Health: supervisors expected to beat, ticket that receives alerts, minutes before a "waiting" note is written on a ticket.
AIFLOW_EXPECTED_SLOTS=wsl:1,wsl:2
AIFLOW_HEALTH_TICKET=JAIF-12
AIFLOW_WAIT_NOTE_MINUTES=20
