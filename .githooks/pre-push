#!/bin/sh
# Runs the v4 tests that the push changes and the smoke tests before anything is pushed (JAIF-581, docs/v4/git-hooks.md).
# The test services are needed for the affected tests (AIFLOW4_TEST_REDIS_URL, AIFLOW4_TEST_DATABASE_URL).
# Git supplies the exact destination SHA for each ref on stdin; the gate checks those ranges.
if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: the working tree has uncommitted changes, so the gate result would not describe what is pushed; commit or stash them." >&2
  exit 1
fi
exec python3 -m aiflow.v4.core.git_hooks pre-push --path . --push-stdin
