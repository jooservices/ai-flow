#!/bin/bash
# Deploy AI Flow v4 from the control-plane machine (lab): optional git bundle -> push -> control image ->
# restart control-api/control-loops -> node release tarball -> install on this node.
#   aiflow4-deploy [bundle-file] [ref]
set -euo pipefail
BUNDLE=${1:-}; REF=${2:-TESTFLOW-30-v4-core}
R=/srv/aiflow/control/repos/ai-flow
cd $R
if [ -n "$BUNDLE" ]; then
  git fetch -q "$BUNDLE" "+$REF:refs/heads/$REF"
  git push -q origin "$REF" 2>&1 | grep -v '^remote:' || true
else
  git fetch -q origin
  case "$REF" in */*) ;; *) REF="origin/$REF" ;; esac   # deploy what GitHub has, not a stale local branch
fi
SHA=$(git rev-parse --short=10 "$REF")
B=/srv/aiflow/build/$SHA; rm -rf "$B"; mkdir -p "$B"; git archive "$REF" | tar -x -C "$B"
docker build -q -f "$B/deploy/v4/control/Dockerfile" -t "aiflow4/control:$SHA" -t aiflow4/control:latest "$B" >/dev/null
AIFLOW4_IMAGE_TAG=$SHA docker compose -f "$B/deploy/v4/control/compose.yaml" up -d 2>&1 | grep -v -e '^$' | tail -2
mkdir -p /srv/aiflow/control/releases
TAR=/srv/aiflow/control/releases/aiflow4-$SHA.tar.gz
git archive --format=tar.gz -o "$TAR" "$REF"
install -m 0755 "$B/deploy/v4/bin/aiflow4-node-install" "$B/deploy/v4/bin/aiflow4-deploy" /usr/local/sbin/
mkdir -p /root/.bridge/out/release; rm -f /root/.bridge/out/release/*.tar.gz
cp "$TAR" /root/.bridge/out/release/; echo "$SHA" > /root/.bridge/out/release/SHA
aiflow4-node-install "$TAR" "$SHA"
for i in $(seq 1 30); do curl -fsS http://127.0.0.1/healthz >/dev/null 2>&1 && break; sleep 2; done
echo "deployed $SHA"
