[Unit]
Description=AI Flow worker %i
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=%h/Workspaces/JOOservices/projects/ai-flow
Environment=PATH=%h/.local/bin:%h/.opencode/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/Workspaces/JOOservices/projects/ai-flow/bin/aiflow-work --id %i
Restart=always
RestartSec=15
# A configuration error (exit 2) is not retried in a tight loop.
RestartPreventExitStatus=2
# On stop the AI process groups are killed with the unit; the lease then expires and another AI continues.
KillMode=control-group

[Install]
WantedBy=default.target
