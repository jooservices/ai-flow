# ai-flow/.env: what is specific to THIS machine, nothing else. A comment must stay on its own line (the file reader does not cut
# a comment after a value).
#   Supervisor settings (roles, merge rules, timing, workers) are in JOOservices/config/aiflow.toml, projects in config/aiflow/*.toml.
#   Secrets (Jira, GitHub, Redis password) are in Workspaces/.env and are never copied here.
# Since JAIF-79 every other AIFLOW_* name (AIFLOW_POLL_SECONDS, AIFLOW_AGENT_ORDER, AIFLOW_DEVELOPER_DEFAULT ...) is a legacy fallback:
# it still works on a machine without TOML files, but [runtime] / [defaults] win, so do not set them here.

# Name of this machine: selects [machines.<name>] (worker count, AI limits) in aiflow.toml and names the machine in
# Jira comments, leases and heartbeats. Must be the same text as the aiflow.toml section: wsl or mac.
AIFLOW_MACHINE=wsl

# Redis shared by all machines, plain TCP. Until the release each machine uses its own container; at the release every machine
# points to the homelab Redis (192.168.10.14:6379, production DB 5, test DB 6; the Mac reaches it through bin/aiflow-redis-tunnel).
# Redis host.
AIFLOW_REDIS_HOST=127.0.0.1
# Redis port: local container 16382, homelab 6379, tunnel 16379.
AIFLOW_REDIS_PORT=16382
# Redis ACL user; empty or absent = none.
# AIFLOW_REDIS_USER=
# Redis database: 5 production, 6 tests.
AIFLOW_REDIS_DB=5
# NAME of the variable in Workspaces/.env that holds the Redis password (never the password itself).
AIFLOW_REDIS_PASSWORD_VAR=WORKSPACES_REDIS_PASSWORD

# Legacy, only for the old aiflow-supervisor@<slot> units (aiflow-work@<n> workers take the number from their unit name).
# AIFLOW_SLOT=1

# Messages to the owner when the operator has a question (optional, put the secrets in Workspaces/.env, not here). No channel: nothing is sent.
# Channel: telegram or smtp.
# AIFLOW_NOTIFY_CHANNEL=telegram
# Telegram bot token and chat id.
# AIFLOW_NOTIFY_TELEGRAM_TOKEN=
# AIFLOW_NOTIFY_TELEGRAM_CHAT=
# SMTP server, port (default 587, STARTTLS), sender, receiver, optional login.
# AIFLOW_NOTIFY_SMTP_HOST=
# AIFLOW_NOTIFY_SMTP_PORT=587
# AIFLOW_NOTIFY_SMTP_FROM=
# AIFLOW_NOTIFY_SMTP_TO=
# AIFLOW_NOTIFY_SMTP_USER=
# AIFLOW_NOTIFY_SMTP_PASSWORD=

# Login of the OpenObserve account that receives the events (the address, org and stream are in aiflow.toml [runtime]). Put the values in
# Workspaces/.env, not here. Without them no event is sent and nothing else changes.
# AIFLOW_OBS_USER=
# AIFLOW_OBS_PASSWORD=

# Shared memory (docs/MEMORY.md). The address is in aiflow.toml [runtime] memory_url; put the secrets in Workspaces/.env, not here.
# Admin token of the supervisor and the control (writes cases, verifies, runs the curator); client token given to the AIs (search and propose only).
# AIFLOW_MEMORY_TOKEN=
# AIFLOW_MEMORY_AI_TOKEN=
# The memory service itself (aiflow-memory.service) reads, from Workspaces/.env, the PostgreSQL it stores into and the file of its tokens:
# AIFLOW_MEMORY_PG_HOST=127.0.0.1
# AIFLOW_MEMORY_PG_PORT=5432
# AIFLOW_MEMORY_PG_DB=ai_memory
# AIFLOW_MEMORY_PG_USER=
# AIFLOW_MEMORY_PG_PASSWORD=
# AIFLOW_MEMORY_HOST=127.0.0.1
# AIFLOW_MEMORY_PORT=8750
# AIFLOW_MEMORY_TOKENS_FILE=JOOservices/config/memory-tokens.json
