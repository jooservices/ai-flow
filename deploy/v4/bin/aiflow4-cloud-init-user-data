#!/usr/bin/env python3
"""Render per-VM cloud-init user-data with a freshly minted one-use join token (docs/v4/fleet-install.md).

  AIFLOW4_PROVISION_KEY=... aiflow4-cloud-init-user-data --provider proxmox|virtualbox|cloud \
      --name NODE --project KEY [--role worker] --control-url https://control --out PATH

The token expires five minutes after this command runs and works once, so render immediately before the VM
boots. The output file is created 0600; delete it after the node has joined. The token is never printed.
"""
import argparse
import json
import os
import re
import sys
import urllib.request
from pathlib import Path

TEMPLATES = Path(__file__).resolve().parents[1] / "cloud-init"
PROVIDERS = ("proxmox", "virtualbox", "cloud")
NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,62}")
CONTROL_URL_RE = re.compile(r"https?://[A-Za-z0-9.:\[\]-]+")
TOKEN_RE = re.compile(r"[A-Za-z0-9_-]{16,128}")


def mint_token(control_url: str, provision_key: str, name: str, role: str, project: str) -> dict:
    body = json.dumps({"provision_key": provision_key, "name": name, "role": role, "project": project}).encode()
    request = urllib.request.Request(f"{control_url}/v1/nodes/join-tokens", data=body, method="POST",
                                     headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.load(response)


def render(template: str, *, token: str, name: str, control_url: str) -> str:
    # Values are checked against narrow patterns so they cannot break out of the YAML or shell quoting.
    if not TOKEN_RE.fullmatch(token):
        raise ValueError("control plane returned an unexpected join token format")
    if not NAME_RE.fullmatch(name):
        raise ValueError("invalid node name")
    if not CONTROL_URL_RE.fullmatch(control_url):
        raise ValueError("invalid control URL")
    return (template.replace("__AIFLOW4_JOIN_TOKEN__", token)
            .replace("__AIFLOW4_NODE_NAME__", name)
            .replace("__AIFLOW4_CONTROL_URL__", control_url))


def write_private(path: Path, content: str) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(content)


def main(argv=None, mint=mint_token) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--provider", choices=PROVIDERS, required=True)
    parser.add_argument("--name", required=True)
    parser.add_argument("--role", default="worker")
    parser.add_argument("--project", required=True)
    parser.add_argument("--control-url", required=True)
    parser.add_argument("--out", type=Path, required=True)
    args = parser.parse_args(argv)
    control_url = args.control_url.rstrip("/")
    provision_key = os.environ.get("AIFLOW4_PROVISION_KEY", "")
    if not provision_key:
        print("set AIFLOW4_PROVISION_KEY from the approved secret manager", file=sys.stderr)
        return 2
    if not NAME_RE.fullmatch(args.name) or not CONTROL_URL_RE.fullmatch(control_url):
        print("invalid --name or --control-url", file=sys.stderr)
        return 2
    template = (TEMPLATES / args.provider / "user-data.yaml").read_text(encoding="utf-8")
    grant = mint(control_url, provision_key, args.name, args.role, args.project)
    write_private(args.out, render(template, token=grant["token"], name=args.name, control_url=control_url))
    print(f"wrote {args.out} for {args.name}; boot it before the join token expires at {grant['expires_at']}",
          file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
