[Unit]
Description=AI Flow v4 worker for account %i
After=network-online.target

[Service]
EnvironmentFile=/etc/aiflow/node.env
Environment="PATH=/opt/aiflow/offline/current/bin:/opt/aiflow/offline/current/python/bin:/opt/aiflow/offline/current/node/bin:/opt/aiflow/offline/current/cli/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment=UV_PYTHON_INSTALL_DIR=/opt/aiflow/offline/current/python/managed
ExecStart=/srv/aiflow/current/.venv/bin/aiflow4 worker --account %i
Restart=always
RestartSec=10
# SIGTERM: the worker stops polling; a running AI step keeps its lease until it ends or the stop timeout hits
KillMode=mixed
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
