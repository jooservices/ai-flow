# Which Jira projects the supervisor watches (comma separated).
AIFLOW_PROJECTS=JAIF
# Name of this machine in comments and leases (mac, wsl).
AIFLOW_MACHINE=wsl
AIFLOW_SLOT=1
# Shared Redis, plain TCP. Until the release this is the Redis container of this machine (127.0.0.1:16382, password
# WORKSPACES_REDIS_PASSWORD). At the release every machine switches to the homelab Redis (production, DB 5, test DB 6):
#   AIFLOW_REDIS_HOST=192.168.10.14  AIFLOW_REDIS_PORT=6379  AIFLOW_REDIS_PASSWORD_VAR=REDIS_PASSWORD   (WSL, direct)
#   AIFLOW_REDIS_HOST=127.0.0.1      AIFLOW_REDIS_PORT=16379  AIFLOW_REDIS_PASSWORD_VAR=REDIS_PASSWORD   (Mac, via bin/aiflow-redis-tunnel)
# The password is read from the variable named by AIFLOW_REDIS_PASSWORD_VAR (root or JOOservices .env), never copied here.
AIFLOW_REDIS_HOST=127.0.0.1
AIFLOW_REDIS_PORT=16382
AIFLOW_REDIS_PASSWORD_VAR=WORKSPACES_REDIS_PASSWORD
AIFLOW_REDIS_DB=5
AIFLOW_REDIS_PREFIX=aiworkflow:
# Timing (seconds unless noted).
AIFLOW_POLL_SECONDS=30
AIFLOW_HEARTBEAT_SECONDS=20
AIFLOW_LEASE_SECONDS=120
AIFLOW_ORPHAN_GRACE_SECONDS=180
AIFLOW_IDLE_MINUTES=30
AIFLOW_MAX_MINUTES=180
AIFLOW_MAX_ATTEMPTS=3
AIFLOW_QUOTA_COOLDOWN_MINUTES=30
# Defaults used when the ticket has no "Repo:" / "Base:" line.
AIFLOW_DEFAULT_REPO=ai-flow
AIFLOW_DEFAULT_BASE=develop
AIFLOW_AGENT_ORDER=Codex,Claude,Grok,OpenCode
# AI per role, as Agent[:model[:effort]]. The Jira field "Agent (AI)" wins for the developer. Codex reads its own model from ~/.codex/config.toml.
AIFLOW_DEVELOPER_DEFAULT=Codex:gpt-6-luna:xhigh
AIFLOW_REVIEWER_DEFAULT=Grok
AIFLOW_QA_DEFAULT=Claude:sonnet
# Model used when OpenCode is the developer (the ticket's Agent field names it); DeepSeek V4.1 Flash Free, set up on every machine; the OpenCode default model may be an expired key.
AIFLOW_OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free
# No AI can take a step on any online machine for this long: the ticket is Blocked (Quota or Offline) and continues by itself.
# AIs that only work when the ticket's Agent field names them (never picked automatically).
AIFLOW_EXPLICIT_ONLY_AIS=OpenCode
AIFLOW_QUOTA_BLOCK_MINUTES=30
AIFLOW_RECHECK_SECONDS=120
# Jira fields.
AIFLOW_BLOCKED_REASON_FIELD=customfield_10215
AIFLOW_REQUIRE_HUMAN_FIELD=customfield_10216
AIFLOW_MODEL_FIELD=customfield_10217
# Pull-request gate. Repos are comma separated; * means every repo.
AIFLOW_AUTO_MERGE_REPOS=*
AIFLOW_CI_REQUIRED_REPOS=
AIFLOW_CI_WAIT_MINUTES=30
AIFLOW_FEEDBACK_SETTLE_MINUTES=5
AIFLOW_GATE_POLL_SECONDS=60
AIFLOW_MERGE_METHOD=merge
AIFLOW_MAX_CYCLES=6
# Accounts whose pull-request comments are automation, not feedback (reviews and threads of bots still count).
AIFLOW_IGNORED_AUTHORS=codecov-commenter,github-actions,sonarqubecloud,sonarcloud,dependabot,codeql,github-advanced-security
# Jira field that shows the machine working on a ticket (text field "Workspace").
AIFLOW_WORKSPACE_FIELD=customfield_10214
# Health: supervisors expected to beat, ticket that receives alerts, minutes before a "waiting" note is written on a ticket.
AIFLOW_EXPECTED_SLOTS=wsl:1,wsl:2
AIFLOW_HEALTH_TICKET=JAIF-12
AIFLOW_WAIT_NOTE_MINUTES=20
